# Vision service settings (copy to .env). VISION_KEY must equal VISION_KEY in apps/backend/.env.
VISION_HOST=127.0.0.1
VISION_PORT=8601
VISION_KEY=replace-with-the-backend-vision-key
BACKEND_URL=http://127.0.0.1:5001
ALLOWED_ORIGINS=http://localhost:3000

# Evidence images (S3 or S3-compatible; local SeaweedFS from infra/start-infra.ps1)
AWS_S3_ENDPOINT=http://127.0.0.1:8333
AWS_S3_BUCKET_REGION=us-east-1
AWS_S3_BUCKET_NAME=traffic-evidence
AWS_S3_ACCESS_KEY=local-dev-access-key
AWS_S3_SECRET_ACCESS_KEY=local-dev-secret-key

# Folders whose videos can be selected in the portal (';'-separated, top level only). Uploads go to data/uploads.
VIDEO_DIRS=C:\path\to\your\videos
MAX_UPLOAD_GB=8
# VISION_DATA_DIR=C:\path\to\vision\data
# Camera clock time zone (Dhaka = UTC+6)
LOCAL_UTC_OFFSET_HOURS=6

# Violation explanations: vision-language model run on this computer (service/vlm.py), from the local Hugging Face
# cache only. Unloaded after VLM_IDLE_MIN minutes without a request.
VLM_MODEL=Qwen/Qwen3.5-2B
VLM_IDLE_MIN=10
