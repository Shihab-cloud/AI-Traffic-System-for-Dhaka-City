NEXT_PUBLIC_BACKEND_URL="http://localhost:5001"

# Firebase (web SDK values — public, read from Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Optional. Shown as a "Request access" mailto on the register page when an
# admin has turned off self-serve sign-up (Admin → Settings → App config).
# Leave empty to omit the button. NEXT_PUBLIC_* values are inlined into the
# client bundle at `next build` — set this before building, not at container
# start.
NEXT_PUBLIC_SUPPORT_EMAIL=""
