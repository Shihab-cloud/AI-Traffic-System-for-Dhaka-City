## App
NODE_ENV=development
APP_NAME="Dhaka Traffic Enforcement"
APP_VERSION=local
PORT=5001

## MongoDB
# Must be a replica set (Atlas always is): account activation, credential rotation and support
# tickets write in transactions, which a standalone mongod rejects with "Transaction numbers are
# only allowed on a replica set". Locally, start mongod with --replSet rs0 and run rs.initiate() once.
# The local MongoDB of infra/start-infra.ps1 (replica set rs0, localhost only, no password)
DATABASE_URL="mongodb://127.0.0.1:27017/dhaka_traffic?replicaSet=rs0"

## Redis
REDIS_HOST=localhost
REDIS_PORT=6379

## URLs
# Public origin of THIS backend. In prod (EC2) this is your API domain, e.g. https://api.example.com
BACKEND_URL="http://localhost:5001"
# Public origin of the frontend. In prod (Vercel) this is your app domain, e.g. https://app.example.com
# This is the CORS-allowed origin for the cross-origin data API, a better-auth
# trusted origin, and the base for email links. No trailing slash.
FRONTEND_URL="http://localhost:3000"
FRONTEND_RESET_PASSWORD_URL="http://localhost:3000/auth/reset-password/"

## Tokens
# Every secret below: a long random string of your own, e.g. from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The backend refuses to start while a placeholder is left in.
RESET_TOKEN_SECRET="replace-with-reset-token-secret"
# Duration string, not a number: `jsonwebtoken` reads a bare number as
# *seconds*, so 86400000 would mean ~2.7 years rather than 24 hours.
RESET_TOKEN_EXPIRATION_TIME=24h
JWT_EXPIRY_SECONDS=900

# Header token for the bootstrap admin-create endpoint.
ADMIN_SETUP_TOKEN="replace-with-admin-setup-token"

## Better Auth
BETTER_AUTH_SECRET="replace-with-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Reverse proxies in front of this service, comma-separated IPs or CIDR ranges.
# Better Auth resolves the client IP by walking `x-forwarded-for` right-to-left
# and skipping these hops. WITHOUT IT, a multi-hop XFF chain (frontend nginx →
# Next auth proxy → backend nginx) is unresolvable and EVERY request shares one
# instance-wide rate-limit bucket — which surfaces as users being randomly
# signed out in production. Rate limiting only runs when NODE_ENV=production,
# so this cannot be reproduced locally.
#
# The value below is the default, spelled out so it is visible and editable.
# A value set here REPLACES the default list rather than extending it, so keep
# the loopback entries unless nothing reaches this service over loopback.
# Narrow it to the proxy's actual subnet where you can. Do NOT list a range that
# also covers real clients (e.g. a VPN's 10.0.0.0/8, or a LAN's
# 192.168.0.0/16). Trusting a client range is harmful twice over: a client
# inside it can forge the leftmost XFF entry and choose its own bucket, and —
# worse — the right-to-left walk runs off the left end of the chain when the
# client's own address is trusted, so no client IP resolves at all and the
# instance lands back on the shared bucket.
#
# Verify in production: `redis-cli --scan --pattern 'no-trusted-ip*'` must be
# empty, and the backend log line "Rate limiting on resolved client IP: ..."
# must show a real client address, not one of your proxies.
TRUSTED_PROXY_CIDRS="127.0.0.0/8,::1,172.16.0.0/12"

## Google OAuth — OPTIONAL. Leave unset to disable Google login.
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

## MFA — 32-byte key, base64-encoded (~44 chars). Encrypts MFA secrets at rest.
# The KEK adapter THROWS at startup if this is unset. Generate with:
#   openssl rand -base64 32
MFA_KEK_B64="replace-with-base64-32-byte-key"

## Mail (SMTP): the local Mailpit of infra/start-infra.ps1 catches every email (inbox http://127.0.0.1:8025) and
## accepts any user / password
MAIL_HOST="127.0.0.1"
MAIL_PORT=1025
MAIL_USER="local"
MAIL_PASS="local"
MAIL_FROM="no-reply@example.com"

## File storage (S3): the local SeaweedFS of infra/start-infra.ps1 (same key pair as infra/s3.json and vision/.env)
AWS_S3_ENDPOINT="http://127.0.0.1:8333"
AWS_S3_BUCKET_NAME="traffic-evidence"
AWS_S3_BUCKET_REGION="us-east-1"
AWS_S3_ACCESS_KEY="local-dev-access-key"
AWS_S3_SECRET_ACCESS_KEY="local-dev-secret-key"

## Vision service (vision/server.py). VISION_KEY: a long random string, the same in vision/.env
VISION_URL="http://127.0.0.1:8601"
VISION_KEY="replace-with-vision-key"
ENABLE_API_DOCS=true

## Violation explanations: local = the vision service's Qwen3.5-2B (no API), rules = a summary of the measurements,
## anthropic = Claude (needs ANTHROPIC_API_KEY and VLM_MODEL)
VLM_PROVIDER=local
# ANTHROPIC_API_KEY=""
# VLM_MODEL=""

## Payments
PAYMENT_PROVIDER=sandbox
CURRENCY=BDT

## Push notifications — OPTIONAL. Leave unset if not using push.
# Firebase Cloud Messaging (web push)
# Leave commented to disable push (placeholder values would crash FcmService on boot).
# FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

## Notification
# Fan-out chunk size for broadcast jobs (default 100).
NOTIFICATION_BROADCAST_CHUNK_SIZE=100

## ts-migrate-mongoose
MIGRATE_CONFIG_PATH="src/config/ts-migrate.config.ts"

## Logging
ENABLE_LOGS=true
SAVE_LOG_FILES=true
LOG_DIR="logs"
DISABLE_CONSOLE_LOGS=false
LOG_ROTATE_MAX_SIZE="5k"
# Keep logs for "1d"/"2" in dev, "15d"/"30d" in prod.
LOG_ROTATE_MAX_FILES="1d"

# Online fine payments: SSLCommerz (Bangladesh; cards, bKash, Nagad, Rocket, internet banking). Get a free sandbox
# store at https://developer.sslcommerz.com/registration/ and put its id and password here; without them only the
# built-in test payment works. SSLCOMMERZ_LIVE=true uses the live gateway (real money: a live store).
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_LIVE="false"
