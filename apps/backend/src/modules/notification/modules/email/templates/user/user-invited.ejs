<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /><title>You're Invited</title></head>
<body style="font-family:sans-serif;max-width:600px;margin:0 auto;padding:24px;color:#222">
  <h2 style="color:#1a56db">You Have Been Invited</h2>
  <p>Hi <%= username %>,</p>
  <p><%= messageContent %></p>
  <p>Click below to accept your invitation and get started.</p>
  <a href="<%= frontendUrl %>" style="display:inline-block;margin-top:16px;padding:10px 20px;background:#1a56db;color:#fff;text-decoration:none;border-radius:4px">Accept Invitation</a>
  <p style="margin-top:32px;font-size:12px;color:#888">You are receiving this because you have email notifications enabled.</p>
</body>
</html>
