<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your verification code</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: Arial, sans-serif; color: #111722; line-height: 1.5; background-color: #f5f7fb; }
      .container { max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 10px; border: 1px solid #e0e0e0; overflow: hidden; }
      .header { padding: 24px; border-bottom: 1px solid #eef0f4; }
      .logo { font-size: 22px; font-weight: 700; color: #1a3aa3; }
      .content { padding: 32px 24px; }
      .greeting { font-size: 18px; font-weight: 600; margin-bottom: 16px; }
      .lead { font-size: 14px; color: #4b5563; margin-bottom: 24px; }
      .code-box { background-color: #f1f5ff; border: 1px solid #c7d2fe; border-radius: 8px; padding: 24px; text-align: center; margin: 24px 0; }
      .code { font-family: 'Courier New', monospace; font-size: 32px; letter-spacing: 8px; font-weight: 700; color: #1a3aa3; }
      .meta { font-size: 13px; color: #6b7280; margin-top: 8px; }
      .footer { padding: 16px 24px; background-color: #fafbff; font-size: 12px; color: #6b7280; border-top: 1px solid #eef0f4; }
      .warning { font-size: 13px; color: #991b1b; margin-top: 16px; padding: 12px; background-color: #fef2f2; border-radius: 6px; border: 1px solid #fecaca; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <div class="logo"><%= appName %></div>
      </div>
      <div class="content">
        <div class="greeting">Hi <%= username %>,</div>
        <p class="lead">
          Use the verification code below to <%= purposeText %>. This code expires in <%= expiryMinutes %> minutes.
        </p>
        <div class="code-box">
          <div class="code"><%= code %></div>
          <div class="meta">Enter this code in <%= appName %> to continue</div>
        </div>
        <div class="warning">
          If you did not request this code, ignore this email and consider changing your password. Never share this code with anyone — <%= appName %> staff will never ask for it.
        </div>
      </div>
      <div class="footer">
        Sent automatically. Do not reply.
      </div>
    </div>
  </body>
</html>
